# Copy this file to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL (n8n database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=n8n

# --- n8n ---
# Encrypts the credentials saved inside n8n. Generate once and keep it safe:
#   openssl rand -hex 32
# If you lose it, n8n cannot decrypt your saved credentials.
N8N_ENCRYPTION_KEY=change-me
TIMEZONE=America/Mexico_City

# --- LLM API keys (used by Python scripts; inside n8n, store them as n8n credentials) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
